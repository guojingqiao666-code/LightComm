{
  "llm": {
    "provider": "nvidia-nim-free",
    "base_url": "https://integrate.api.nvidia.com/v1",
    "api_key_env": "NVIDIA_API_KEY",
    "models": {
      "large": "nvidia/nemotron-3-super-120b-a12b",
      "small": "nvidia/nemotron-3.5-lightning-30b-a3b"
    },
    "prices": {
      "nvidia/nemotron-3-super-120b-a12b": {"input_per_mtok": 0.0, "output_per_mtok": 0.0},
      "nvidia/nemotron-3.5-lightning-30b-a3b": {"input_per_mtok": 0.0, "output_per_mtok": 0.0}
    },
    "timeout": 120,
    "max_retries": 3
  },
  "experiment": {
    "strategies": ["single_agent", "full_context", "summary", "action_state", "lightcomm"],
    "runs_per_config": 3,
    "max_concurrency": 2,
    "budget_usd_limit": 5.0,
    "seed": 42,
    "tasks": ["multihop", "bug_triage", "doc_edit"],
    "compressor_tier": "small",
    "router_overrides": {}
  }
}
